# Kali apt snapshot pin — frozen package versions consumed by docker/kali/Dockerfile.
# Updates to any field below require security-reviewer approval (see CODEOWNERS).
# Path: docker/kali/kali-apt-snapshot.env (per PR-5.5 decision).

KALI_APT_REPO_URL=https://http.kali.org/kali
KALI_APT_SNAPSHOT_DATE=2026-07-22

# Per-package version pins. PR-6 verifies these via build + runtime smoke.
# Refreshed 2026-07-22 to the live kali-rolling candidates (the old pins were
# removed from the rolling repo → apt exit 100).
KALI_APT_PKG_GOBUSTER=3.8.2-1
KALI_APT_PKG_SQLMAP=1.10.6-1
KALI_APT_PKG_NIKTO=1:2.6.0-0kali4
KALI_APT_PKG_FFUF=2.1.0-1+b11

# SHA-256 lock over (filename || size || sha256) of each pinned .deb file.
# `make build-kali` computes and updates this; CI fails on drift.
KALI_APT_PACKAGES_LOCK_SHA256=
